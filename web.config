<?xml version="1.0" encoding="utf-8"?>
<!-- 회사 내부 서버가 IIS(Windows)일 때만 필요합니다. 다른 서버에서는 무시됩니다.
     IIS는 .webmanifest 확장자를 기본으로 내보내지 않아 '앱으로 설치'가 안 되므로 형식을 등록합니다. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <!-- 앱 파일이 오래 캐시되지 않도록 (업데이트가 바로 반영되게) -->
        <add name="Cache-Control" value="no-cache" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
